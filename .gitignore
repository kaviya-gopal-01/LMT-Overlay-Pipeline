# Python bytecode / cache 
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
# See README.md "Development" section / Task 3 discussion for why these
# are excluded rather than committed.
.venv/
venv/
env/
ENV/

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/

# Test / lint / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Project runtime artifact
# Generated by gui_selector.py; contains the LAST-USED FILE PATHS ON THIS
# MACHINE (e.g. "/home/alice/Desktop/experiment3/tracking.sqlite"). This is
# machine- and user-specific convenience state, not project configuration,
# and committing it would leak one contributor's local folder layout into
# everyone else's checkout.
settings.json

# Every run's output videos. These are large, generated, timestamped
# binary files, exactly what git (a text-diff-oriented tool) handles
# worst. The pipeline creates this directory automatically; it should
# never be committed.
output/

# Default local dev/test artifacts matching config.py's fallback paths
# (LMT_INPUT_DIR, LMT_DATABASE_PATH). If a contributor drops a test
# database or sample videos in the repo root while working locally
# (matching config.py's defaults: ./tracking.sqlite, ./input_videos/),
# these keep that out of commits too.
/tracking.sqlite
/input_videos/

# Editor / OS cruft
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
